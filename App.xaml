<Application x:Class="QrCodeGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The shared suite theme (HueTheme kit). Every control style and every theme colour comes from it. -->
                <ResourceDictionary Source="Theme/HueTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Content colours =====
                 Not theme colours: the surface a QR code is judged on. A code is printed on paper,
                 so the preview shows it on white whatever the app's theme is, also under a Windows
                 contrast theme. Content.PaperHint is placeholder text on that white (4.8:1). -->
            <SolidColorBrush x:Key="Content.Paper"     Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Content.PaperHint" Color="#FF6B7280" />

            <!-- ===== Colour swatch button =====
                 A button whose face is a colour the user chose; clicking it opens the colour picker
                 or picks a palette entry. The theme has no such control (Hue.Swatch is a round radio
                 choice), so the app keeps its own template, drawn with theme tokens. Background is
                 set from code to the colour it shows. -->
            <Style x:Key="Qr.Swatch" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Edge" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Brush.ControlEdge}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Item}" SnapsToDevicePixels="True" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="Edge" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
