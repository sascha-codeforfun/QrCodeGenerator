<Window x:Class="QrCodeGenerator.Dialogs.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Hue.Window}">

    <!-- The suite's dialog structure: a 2 px rim in the family colour, a head band with the
         title, a body one step lighter than the cards behind, buttons bottom right. -->
    <Border Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.AccentEdge}"
            BorderThickness="2">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Chrome}"
                    BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="26,20">
                <TextBlock Text="Pick a color" Style="{StaticResource Text.Heading}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="26,0,26,22">
                <Button Content="Cancel" Click="CancelButton_Click"/>
                <Button Content="Use color" Style="{StaticResource Hue.Button.Primary}" Margin="10,0,0,0"
                        Click="UseButton_Click"/>
            </StackPanel>

            <StackPanel Margin="26,20,26,24">
                <!-- Preview + hex. The preview shows the colour being picked (content, not theme). -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" x:Name="PreviewSwatch" Width="72" Height="72"
                            CornerRadius="{StaticResource Radius.Control}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Label Content="Hex"/>
                        <TextBox x:Name="HexBox" TextChanged="HexBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- RGB -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="R"/>
                        <TextBox x:Name="RBox" TextChanged="Rgb_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="G"/>
                        <TextBox x:Name="GBox" TextChanged="Rgb_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Label Content="B"/>
                        <TextBox x:Name="BBox" TextChanged="Rgb_TextChanged"/>
                    </StackPanel>
                </Grid>

                <!-- Contrast hint (shown only when a pair color is given). The sample shows the
                     two colours of the code against each other (content, not theme). -->
                <Border x:Name="ContrastPanel" Background="{DynamicResource Brush.Base}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}"
                        Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="ContrastSample" Width="64" Height="40"
                                CornerRadius="{StaticResource Radius.Item}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <TextBlock x:Name="ContrastSampleText" Text="▚▞" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ContrastText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ContrastAdvice" Style="{StaticResource Text.Body}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Label Content="Palette"/>
                <WrapPanel x:Name="PalettePanel"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
