<Window x:Class="QrCodeGenerator.Dialogs.GlyphPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose font &amp; glyph" Height="800" Width="1180"
        MinHeight="540" MinWidth="700" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Hue.Window}">

    <Window.Resources>
        <!-- A square tile that shows one glyph of the chosen font. The theme has no such control,
             so the tile keeps its own template, drawn with theme tokens. Up to 250 on a page:
             no glow (a glow per tile would make scrolling sluggish). -->
        <Style x:Key="GlyphTile" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Raised}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Hue.FocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tb" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.ControlEdge}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Item}"
                                Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="tb" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The suite's dialog structure: rim in the family colour, head band, lighter body, buttons bottom right. -->
    <Border Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.AccentEdge}"
            BorderThickness="2">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Chrome}"
                    BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="26,20">
                <TextBlock Text="Choose font &amp; glyph" Style="{StaticResource Text.Heading}" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="26,20,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Font row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Label Content="Font"/>
                        <TextBlock x:Name="FontNameText" Style="{StaticResource Text.Body}" Text="No font chosen"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="System fonts…" Click="SystemFontsClick"
                            VerticalAlignment="Bottom" Margin="0,0,8,0"
                            ToolTip="Pick an installed font by name"/>
                    <Button Grid.Column="2" Content="Browse…" Click="BrowseClick"
                            VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="Clear" Click="ClearFontClick" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Search + pager -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="SearchBox_TextChanged"
                             ToolTip="Filter by code point, e.g. 21 or 0041 (hex)"
                             AutomationProperties.Name="Filter by code point"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Content="‹ Prev" Click="PrevButton_Click" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CountText" VerticalAlignment="Center" MinWidth="190"
                                   TextAlignment="Center" Style="{StaticResource Text.Body}"/>
                        <Button x:Name="NextButton" Content="Next ›" Click="NextButton_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Glyph grid: a well, set into the dialog body -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Base}" BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Card}">
                    <Grid>
                        <TextBlock x:Name="EmptyHint" Text="Pick a font to begin."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Body}"/>
                        <ScrollViewer x:Name="GlyphScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                            <WrapPanel x:Name="GlyphPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Selected chars + preview + Cancel/OK -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Selected character(s) — click glyphs above, or type here"/>
                        <TextBox x:Name="CharsBox" TextChanged="CharsBox_TextChanged"/>
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Bottom" Width="40" Height="40"
                            Background="{DynamicResource Brush.Base}" BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Item}" ToolTip="Preview">
                        <Image x:Name="PreviewImage" Margin="5" Stretch="Uniform"/>
                    </Border>
                    <Button Grid.Column="4" Content="Cancel" Click="CancelClick"
                            VerticalAlignment="Bottom" Margin="0,0,10,0"/>
                    <Button Grid.Column="5" Content="OK" Style="{StaticResource Hue.Button.Primary}" Click="OkClick"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
