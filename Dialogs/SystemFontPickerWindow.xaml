<Window x:Class="QrCodeGenerator.Dialogs.SystemFontPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick an installed font" Height="580" Width="500"
        MinHeight="420" MinWidth="380" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Hue.Window}">

    <!-- The suite's dialog structure: rim in the family colour, head band, lighter body, buttons bottom right. -->
    <Border Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.AccentEdge}"
            BorderThickness="2">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Chrome}"
                    BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1" Padding="26,20">
                <TextBlock Text="Pick an installed font" Style="{StaticResource Text.Heading}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="26,0,26,22">
                <Button Content="Cancel" Click="CancelButton_Click"/>
                <Button Content="Use font" Style="{StaticResource Hue.Button.Primary}" Margin="10,0,0,0"
                        Click="UseButton_Click"/>
            </StackPanel>

            <Grid Margin="26,20,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                         ToolTip="Filter by font name" AutomationProperties.Name="Filter by font name"/>

                <TextBlock Grid.Row="1" x:Name="CountText" Style="{StaticResource Text.Body}" Margin="2,8,0,8"/>

                <!-- The theme's list: hover, selection bar and keyboard focus come from its style. -->
                <ListBox Grid.Row="2" x:Name="FontList"
                         MouseDoubleClick="FontList_MouseDoubleClick"
                         AutomationProperties.Name="Installed fonts"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
