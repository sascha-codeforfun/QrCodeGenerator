<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>QrCodeGenerator</AssemblyName>
    <RootNamespace>QrCodeGenerator</RootNamespace>
    <ApplicationTitle>QR Code Generator</ApplicationTitle>
    <!-- Exe icon shown in Explorer, taskbar and Alt-Tab -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Reproducible build: no PDB / no build-folder paths baked into the assembly. -->
    <DebugType>none</DebugType>
    <!-- No commit hash appended to the product version: a build from a git clone matches one from a zip. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <Version>1.0.5</Version>
  </PropertyGroup>

  <!-- Publish settings: a plain `dotnet publish -c Release` produces one self-contained
       win-x64 exe with all of .NET and the native WPF libraries inside. Command-line
       -p:/-r switches (RepoBuilder, CI) still work and simply set the same values. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK that built the exe, shown in the header under the version (HueVersion.Sdk). -->
    <AssemblyMetadata Include="SdkVersion" Value="$(NETCoreSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR encoding (MIT). No built-in .NET QR encoder exists. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded into the assembly so the window icon and header image work
         from the single-file exe (no loose files needed). -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app_256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship a sample schema next to the exe; auto-loaded on startup if present. -->
    <None Update="url-schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
